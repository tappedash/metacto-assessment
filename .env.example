# Copy to .env:  cp .env.example .env

# Postgres + pgvector from docker-compose.yml. DB_PORT is the host port Docker Compose
# publishes; keep it in sync with DATABASE_URL.
DB_PORT=5433
DATABASE_URL=postgresql://needs:needs@localhost:5433/needs_hub

# AI provider: "mock" runs without a key (deterministic); "openai" calls the OpenAI API.
AI_PROVIDER=mock
OPENAI_API_KEY=
# GPT model for classification, Need refinement, AI Brief, rubric prefill, update drafts
OPENAI_MODEL=
# Embedding model for semantic retrieval. Vectors are requested at 1536 dimensions
# (the pgvector column size); changing that size needs a migration and re-embedding.
OPENAI_EMBEDDING_MODEL=
# When "true" with AI_PROVIDER=openai, structured outputs are saved to fixtures/ai/
# so the mock provider can replay them.
AI_RECORD_FIXTURES=false

# Email: Mailpit SMTP from docker-compose.yml (inbox UI: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Needs Hub <updates@needs-hub.local>"

# Matching timeout for the synchronous submit path (ms)
MATCH_TIMEOUT_MS=3000
