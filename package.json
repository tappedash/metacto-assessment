{
  "name": "needs-hub",
  "version": "0.1.0",
  "private": true,
  "description": "AI-first Customer Needs platform: Feature Request -> AI understanding -> Customer Need -> PM decision -> Delivery -> Stakeholder update",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "npm run db:seed && vitest run tests/integration",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts && npm run db:migrate && npm run db:seed",
    "setup": "npm run db:up && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "next": "^16.4.0",
    "nodemailer": "^10.0.15",
    "openai": "^7.30.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
